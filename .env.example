# WhatsApp Cloud API (Meta for Developers → free tier)
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_ACCESS_TOKEN=

# Fast2SMS (fast2sms.com) — for Idea 2's direct-to-customer link
FAST2SMS_API_KEY=

# Firebase (Firestore — free Spark plan)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
